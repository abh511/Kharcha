<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Kharcha" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/leaf</item>
        <item name="android:colorAccent">@color/leaf</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>

    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/field</item>
        <item name="android:padding">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="PrimaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:background">@drawable/button</item>
        <item name="android:textColor">@color/paper</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="GhostButton" parent="PrimaryButton">
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/button_ghost</item>
        <item name="android:textColor">@color/ink</item>
    </style>
</resources>
