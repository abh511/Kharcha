# Postgres connection. On Neon, use the direct (non-pooled) connection string (it ends with ?sslmode=require).
# The pooled one (host contains "-pooler") breaks LISTEN/NOTIFY and the migration lock.
DATABASE_URL=postgres://kharcha:kharcha@localhost:5432/kharcha

# 32+ random characters. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Timezone used to decide which day/month a payment belongs to
APP_TZ=Asia/Kolkata

# Set to false after you've created your own account, so nobody else can sign up on your server
ALLOW_SIGNUP=true

# Background worker settings
RUN_WORKER=true
WORKER_CONCURRENCY=4

PORT=8080
NODE_ENV=production
